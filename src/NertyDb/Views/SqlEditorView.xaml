<UserControl x:Class="NertyDb.Views.SqlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vm="clr-namespace:NertyDb.ViewModels"
             xmlns:services="clr-namespace:NertyDb.Services"
             Background="{DynamicResource BgMainBrush}"
             Foreground="{DynamicResource FgMainBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuteCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Editor Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="▶ Executar (F5)" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,4" ToolTip="Executar consulta selecionada ou todo o script (F5)" />
                    <Button Content="⏹ Parar" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="10,4" ToolTip="Cancelar consulta em execução" />
                    <Button Content="🪄 Formatar" Command="{Binding FormatSqlCommand}" Margin="0,0,8,0" ToolTip="Padronizar palavras-chave SQL" />
                    
                    <!-- Senior Templates Dropdown Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
                        <MenuItem Header="📚 Modelos Senior ▾" Foreground="{DynamicResource FgMainBrush}" Padding="8,4">
                            <MenuItem.ItemsSource>
                                <Binding Path="AvailableSnippets" />
                            </MenuItem.ItemsSource>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Command" Value="{Binding DataContext.InsertSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>

                    <Button Content="📤 Exportar..." Command="{Binding ExportCurrentResultCommand}" Margin="0,0,6,0" ToolTip="Exportar o resultado atual para CSV, Excel ou JSON" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgSecondaryBrush}" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Splitter Container: Top Editor & Bottom Results -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="100" />
                <RowDefinition Height="5" />
                <RowDefinition Height="4*" MinHeight="100" />
            </Grid.RowDefinitions>

            <!-- SQL Editor (AvalonEdit) -->
            <Border Grid.Row="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <avalonedit:TextEditor x:Name="Editor"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontSize="13"
                                       ShowLineNumbers="True"
                                       Background="Transparent"
                                       Foreground="{DynamicResource FgMainBrush}"
                                       LineNumbersForeground="{DynamicResource FgMutedBrush}"
                                       WordWrap="False"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Auto" />
            </Border>

            <!-- Splitter Grip -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" Cursor="SizeNS" />

            <!-- Bottom Tabs (Results / Messages) -->
            <TabControl Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}">
                <!-- Dynamic Result Tabs -->
                <TabItem Header="📊 Resultados" IsSelected="True">
                    <Grid>
                        <TabControl ItemsSource="{Binding ResultTabs}"
                                    SelectedIndex="{Binding SelectedResultTabIndex, Mode=TwoWay}"
                                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding RowCount, StringFormat='({0:N0})'}" Foreground="{DynamicResource FgMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:SqlResultTabViewModel}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Filter / Expression Bar (DBeaver style) -->
                                        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                                            <DockPanel>
                                                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,6,0" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" DockPanel.Dock="Left" />
                                                <TextBox Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center" 
                                                         ToolTip="Filtrar resultados na grade (filtro rápido em memória)" 
                                                         Foreground="{DynamicResource FgMainBrush}" />
                                            </DockPanel>
                                        </Border>

                                        <!-- Editable Result DataGrid -->
                                        <DataGrid x:Name="ResultGrid"
                                                  Grid.Row="1"
                                                  ItemsSource="{Binding FilteredView}"
                                                  AutoGenerateColumns="True"
                                                  AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                                                  BeginningEdit="ResultGrid_BeginningEdit"
                                                  CellEditEnding="ResultGrid_CellEditEnding"
                                                  LoadingRow="ResultGrid_LoadingRow"
                                                  SelectedCellsChanged="ResultGrid_SelectedCellsChanged"
                                                  PreviewKeyDown="ResultGrid_PreviewKeyDown"
                                                  Loaded="ResultGrid_Loaded"
                                                  IsReadOnly="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  CanUserSortColumns="True"
                                                  CanUserReorderColumns="True"
                                                  CanUserResizeColumns="True"
                                                  SelectionUnit="CellOrRowHeader"
                                                  SelectionMode="Extended">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="🔄 Atualizar Resultado (F5)" Command="{Binding RefreshCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="➕ Inserir Nova Linha (Insert)" Command="{Binding AddRowCommand}" />
                                                    <MenuItem Header="📋 Duplicar Linha Selecionada (Ctrl+Alt+Down)" Command="{Binding DuplicateRowCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="🗑️ Marcar Linha(s) para Exclusão (Delete)" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="↩️ Descartar Alterações da Linha" Click="DiscardResultRow_Click" />
                                                    <Separator />
                                                    <MenuItem Header="📋 Copiar Célula (Ctrl+C)" Click="CopyResultCell_Click" />
                                                    <MenuItem Header="📑 Copiar Linha(s) como CSV" Click="CopyResultRowsCsv_Click" />
                                                    <MenuItem Header="💾 Copiar Linha(s) como INSERT SQL" Click="CopyResultRowsSql_Click" />
                                                    <Separator />
                                                    <MenuItem Header="📤 Exportar Dados..." Command="{Binding ExportCommand}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                        </DataGrid>

                                        <!-- Selection Aggregation Stats Bar (DBeaver style) -->
                                        <Border Grid.Row="2" 
                                                Background="{DynamicResource BgSurfaceBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="0,1,0,0" 
                                                Padding="8,3"
                                                Visibility="{Binding SelectionStats.HasSelection, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                        <TextBlock Text="📊 Seleção" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectionStats.FormattedSummary}" 
                                                               FontFamily="Consolas, Segoe UI" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource FgMainBrush}" 
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- DBeaver Result Toolbar (Positioned at Bottom of Results) -->
                                        <Border Grid.Row="3" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
                                            <DockPanel LastChildFill="True">
                                                <!-- Left: Actions, Navigation, Limit and Stats -->
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <!-- Refresh Button -->
                                                    <Button Content="🔄 Atualizar" Command="{Binding RefreshCommand}" Padding="6,2" Margin="0,0,3,0" ToolTip="Atualizar / Reexecutar consulta (F5)" />

                                                    <!-- Commit Changes Button -->
                                                    <Button Content="💾 Salvar" Command="{Binding CommitChangesCommand}" Style="{StaticResource SuccessButton}" Padding="6,2" Margin="0,0,2,0" ToolTip="Salvar alterações no banco de dados (Ctrl+S)" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}" />
                                                    
                                                    <!-- Discard Changes Button -->
                                                    <Button Content="❌ Cancelar" Command="{Binding DiscardChangesCommand}" Padding="5,2" Margin="0,0,4,0" ToolTip="Cancelar e reverter alterações pendentes" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}" />

                                                    <!-- Pending Badge -->
                                                    <Border Background="{DynamicResource DiffModifiedBgBrush}" BorderBrush="{DynamicResource AccentWarningBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PendingBadgeText}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource DiffModifiedFgBrush}" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Row Manipulation Buttons -->
                                                    <Button Content="➕ Inserir" Command="{Binding AddRowCommand}" Padding="5,2" Margin="0,0,2,0" Style="{StaticResource PrimaryButton}" ToolTip="Inserir nova linha na grade (Insert)" />
                                                    <Button Content="📋 Duplicar" Command="{Binding DuplicateRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResultGrid}" Padding="5,2" Margin="0,0,2,0" ToolTip="Duplicar linha selecionada (Ctrl+Alt+Down)" />
                                                    <Button Content="🗑️ Excluir" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedItems, ElementName=ResultGrid}" Padding="5,2" Margin="0,0,4,0" Style="{StaticResource DangerButton}" ToolTip="Marcar linha(s) selecionada(s) para exclusão (Delete)" />

                                                    <!-- Separator -->
                                                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center" />

                                                    <!-- Navigation Buttons -->
                                                    <Button Content="⏮" Command="{Binding FirstPageCommand}" Padding="5,1" Margin="0,0,1,0" ToolTip="Primeira página" />
                                                    <Button Content="◀" Command="{Binding PrevPageCommand}" Padding="5,1" Margin="0,0,1,0" ToolTip="Página anterior" />
                                                    <Button Content="▶" Command="{Binding NextPageCommand}" Padding="5,1" Margin="0,0,1,0" ToolTip="Próxima página" />
                                                    <Button Content="⏭" Command="{Binding LastPageCommand}" Padding="5,1" Margin="0,0,4,0" ToolTip="Última página" />

                                                    <!-- Separator -->
                                                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center" />

                                                    <!-- Export Button -->
                                                    <Button Content="📤 Exportar dados" Command="{Binding ExportCommand}" Padding="6,2" Margin="0,0,4,0" ToolTip="Exportar resultados para CSV, Excel ou JSON" />

                                                    <!-- Separator -->
                                                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center" />

                                                    <!-- Limit Selector (DBeaver style) -->
                                                    <TextBlock Text="⚙️ Limite:" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="2,0,3,0" />
                                                    <ComboBox SelectedValue="{Binding PageSize, Mode=TwoWay}" SelectedValuePath="Tag" Width="70" Height="22" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Limite de linhas recuperadas">
                                                        <ComboBoxItem Content="50" Tag="50" />
                                                        <ComboBoxItem Content="100" Tag="100" />
                                                        <ComboBoxItem Content="200" Tag="200" IsSelected="True" />
                                                        <ComboBoxItem Content="500" Tag="500" />
                                                        <ComboBoxItem Content="1000" Tag="1000" />
                                                        <ComboBoxItem Content="Sem limite" Tag="0" />
                                                    </ComboBox>

                                                    <!-- Page Indicator -->
                                                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CurrentPage, StringFormat='Pág: {0}'}" FontSize="10" Foreground="{DynamicResource FgSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Separator -->
                                                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center" />

                                                    <!-- Status and Timing Info -->
                                                    <TextBlock Text="{Binding ExecutionStatusText}" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="4,0,6,0" />
                                                </StackPanel>

                                                <!-- Right: Read-Only / Writable Badge & Locale -->
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding ReadOnlyBadgeText}" FontWeight="SemiBold" FontSize="10" Foreground="{Binding ReadOnlyBadgeColor}" VerticalAlignment="Center" ToolTip="{Binding IsReadOnlyReason}" />
                                                    </Border>

                                                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="pt_BR | UTF-8" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>

                        <!-- Empty Placeholder when no query has run -->
                        <Border Background="{DynamicResource BgMainBrush}" Visibility="{Binding HasResults, Converter={StaticResource InvBoolToVis}}" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💡 Dica de Suporte Senior" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Escreva suas consultas SQL ou selecione um modelo no menu 'Modelos Senior'." Foreground="{DynamicResource FgSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Atalhos: F5 (Executar) | Ctrl+Espaço (Autocomplete de tabelas e colunas) | F1 (Guia de Atalhos)" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Messages / Structured Logs Tab -->
                <TabItem Header="💬 Mensagens">
                    <Grid Background="{DynamicResource BgInputBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Messages Toolbar -->
                        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="Registro estruturado de execuções, avisos e erros" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="🗑️ Limpar Mensagens" Click="ClearMessages_Click" Padding="6,2" ToolTip="Limpar histórico de mensagens" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Structured Log List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Source={x:Static services:AppLogService.Instance}, Path=Entries}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,2,2,2" Padding="6,4" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Level Badge -->
                                            <Border Grid.Column="0" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <!-- Timestamp and Source -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Message and Details -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource FgMainBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Details}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource FgMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Execution Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Linhas afetadas: " Foreground="{DynamicResource FgMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalRowsAffected}" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Duração: " Foreground="{DynamicResource FgMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastDurationMs, StringFormat='{}{0} ms'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

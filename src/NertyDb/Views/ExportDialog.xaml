<Window x:Class="NertyDb.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Dados — NertyDb"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="📤 Assistente de Exportação de Dados" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" />
                <TextBlock Text="{Binding TotalRowCount, StringFormat='({0:N0} linhas)'}" HorizontalAlignment="Right" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main Form & Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Format & File Options -->
            <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Formato de Saída:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Arquivo de Destino:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="4" Content="Procurar..." Command="{Binding BrowseFileCommand}" VerticalAlignment="Bottom" Padding="12,6" />
                    </Grid>

                    <!-- CSV Specific Parameters -->
                    <Grid Visibility="{Binding IsCsvFormat, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Delimitador:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableDelimiters}" SelectedItem="{Binding Delimiter, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qualificador:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <TextBox Text="{Binding TextQualifier, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Codificação / Charset:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableEncodings}" SelectedItem="{Binding EncodingName, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Grid.Column="6" Content="Incluir Cabeçalhos" IsChecked="{Binding IncludeHeaders, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="4,0,0,6" Foreground="{DynamicResource FgMainBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview Box -->
            <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Pré-visualização das Primeiras Linhas:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" Margin="4,0,4,6" />
                    <TextBox Grid.Row="1"
                             Text="{Binding PreviewText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="11"
                             Background="{DynamicResource BgInputBrush}"
                             Foreground="{DynamicResource FgMainBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="6"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <!-- Status Message Banner -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource BgSurfaceBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="SemiBold" FontSize="11" />
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="📋 Copiar Tudo (CSV)" Command="{Binding CopyToClipboardCommand}" Margin="0,0,6,0" Padding="12,6" />
                <Button Content="📂 Abrir Pasta" Command="{Binding OpenFolderCommand}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" Padding="12,6" />
                <Button Content="📄 Abrir Arquivo" Command="{Binding OpenFileCommand}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" Padding="12,6" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" Click="Close_Click" Margin="0,0,8,0" Padding="16,6" />
                <Button Content="💾 Exportar Arquivo" Command="{Binding ExecuteExportCommand}" Style="{StaticResource PrimaryButton}" Padding="20,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

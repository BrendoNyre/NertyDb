<Window x:Class="NertyDb.Views.ShortcutsHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⌨️ Guia de Atalhos do Teclado (Padrão DBeaver)"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⌨️ Atalhos de Teclado (Padrão DBeaver / Senior)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Lista rápida de atalhos e comandos para máxima produtividade no NertyDb." FontSize="12" Foreground="{DynamicResource FgMutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Shortcut Cards Scrollable List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Group 1: Execução SQL -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚡ Execução de Consultas SQL" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="F5  ou  Ctrl + Enter" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Executa a instrução SQL sob o cursor ou a seleção" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt + X" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Executa todo o script SQL do editor" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Espaço" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Abre o autocomplete com tabelas e colunas Senior documentadas" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Group 2: Edição de Código SQL -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📝 Edição e Formatação de Código" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Shift + F" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Formata o SQL (indentação e palavras-chave maiúsculas)" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + /" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Comenta ou descomenta a linha atual (--)" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Shift + /" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Comenta ou descomenta o bloco selecionado (/* ... */)" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Alt + Down" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Duplica a linha atual no editor" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + Shift + L" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Exclui a linha atual do editor" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + Shift + U" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Converte a seleção para MAIÚSCULAS" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Group 3: Grade de Dados Interativa -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📊 Grade de Dados e Edição Inline" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Insert" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Insere uma nova linha vazia para preenchimento" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Delete" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Marca as linhas selecionadas para exclusão" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + S" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Abre a janela de confirmação e Salva alterações no banco" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="F5" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Atualiza os dados da grade reexecutando a consulta" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Seleção de Células" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Calcula automaticamente Soma, Média, Mín, Máx e Contagem" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <TextBlock Text="Pressione ESC ou clique em Fechar" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Fechar" IsDefault="True" IsCancel="True" Click="CloseButton_Click" Padding="16,4" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

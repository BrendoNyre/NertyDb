<UserControl x:Class="NertyDb.Views.TableDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NertyDb.Views"
             Background="{DynamicResource BgMainBrush}"
             Foreground="{DynamicResource FgMainBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="Insert" Command="{Binding AddRowCommand}" />
        <KeyBinding Key="Insert" Modifiers="Ctrl" Command="{Binding AddRowCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=MainDataGrid}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedItems, ElementName=MainDataGrid}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding CommitChangesCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding DiscardChangesCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Action & Pagination Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <!-- Left: Quick Filter & Row Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Quick Filter Search Box -->
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,4,0" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
                            <TextBox Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" Width="150" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Content="🔄 Atualizar" Command="{Binding RefreshCommand}" Margin="0,0,4,0" ToolTip="Recarregar dados do banco (F5)" />
                    <Button Content="➕ Inserir Linha" Command="{Binding AddRowCommand}" Margin="0,0,4,0" Style="{StaticResource PrimaryButton}" ToolTip="Inserir nova linha editável (Insert)" />
                    <Button Content="📋 Duplicar Linha" Command="{Binding DuplicateRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=MainDataGrid}" Margin="0,0,4,0" ToolTip="Duplicar linha selecionada (Ctrl+D)" />
                    <Button Content="🗑️ Excluir Linha" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedItems, ElementName=MainDataGrid}" Margin="0,0,6,0" Style="{StaticResource DangerButton}" ToolTip="Marcar linha(s) selecionada(s) para exclusão (Delete)" />
                    <Button Content="📤 Exportar..." Command="{Binding ExportCommand}" Margin="0,0,6,0" ToolTip="Exportar dados para CSV, Excel ou JSON" />
                </StackPanel>

                <!-- Right: Pending Changes & Pagination Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Pending Changes Indicator & Commit Button -->
                    <Border Background="{DynamicResource DiffModifiedBgBrush}"
                            BorderBrush="{DynamicResource AccentWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PendingBadgeText}" FontWeight="Bold" Foreground="{DynamicResource DiffModifiedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="💾 Salvar Alterações" Command="{Binding CommitChangesCommand}" Style="{StaticResource SuccessButton}" Padding="10,3" Margin="0,0,4,0" ToolTip="Salvar alterações no banco de dados (Ctrl+S)" />
                            <Button Content="↩️ Descartar" Command="{Binding DiscardChangesCommand}" Padding="8,3" ToolTip="Descartar todas as alterações pendentes (Ctrl+Z)" />
                        </StackPanel>
                    </Border>

                    <!-- Pagination Controls -->
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮" Command="{Binding FirstPageCommand}" Padding="6,2" Margin="0,0,2,0" ToolTip="Primeira página" />
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Padding="6,2" Margin="0,0,4,0" ToolTip="Página anterior" />
                            
                            <TextBlock Text="{Binding PaginationSummary}" Foreground="{DynamicResource FgSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,4,0" FontSize="11" />
                            
                            <Button Content="➕ Carregar Mais" Command="{Binding LoadMoreRowsCommand}" Padding="8,2" Margin="4,0,4,0" ToolTip="Carregar próxima página de registros" />
                            
                            <Button Content="▶" Command="{Binding NextPageCommand}" Padding="6,2" Margin="2,0,2,0" ToolTip="Próxima página" />
                            <Button Content="⏭" Command="{Binding LastPageCommand}" Padding="6,2" Margin="0,0,6,0" ToolTip="Última página" />

                            <TextBlock Text="Por pág:" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="4,0,4,0" FontSize="11" />
                            <ComboBox SelectedValue="{Binding PageSize, Mode=TwoWay}" SelectedValuePath="Tag" Width="75" VerticalAlignment="Center">
                                <ComboBoxItem Content="50" Tag="50" />
                                <ComboBoxItem Content="100" Tag="100" />
                                <ComboBoxItem Content="200" Tag="200" IsSelected="True" />
                                <ComboBoxItem Content="500" Tag="500" />
                                <ComboBoxItem Content="1000" Tag="1000" />
                                <ComboBoxItem Content="Todas" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- No Primary Key Warning Banner -->
        <Border Grid.Row="1"
                Background="#33EAB308"
                BorderBrush="#EAB308"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding HasPrimaryKey, Converter={StaticResource InvBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️ " FontSize="12" />
                <TextBlock Text="Esta tabela/view não possui chave primária (PK) definida. A edição inline e exclusão estão desativadas por segurança para evitar alterações inconsistentes." FontSize="11" FontWeight="SemiBold" Foreground="#FDE047" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main DataGrid -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="MainDataGrid"
                      ItemsSource="{Binding FilteredView}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="MainDataGrid_AutoGeneratingColumn"
                      BeginningEdit="MainDataGrid_BeginningEdit"
                      CellEditEnding="MainDataGrid_CellEditEnding"
                      LoadingRow="MainDataGrid_LoadingRow"
                      Sorting="MainDataGrid_Sorting"
                      SelectedCellsChanged="MainDataGrid_SelectedCellsChanged"
                      PreviewKeyDown="MainDataGrid_PreviewKeyDown"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="{Binding IsReadOnly}"
                      SelectionUnit="CellOrRowHeader"
                      SelectionMode="Extended">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕ Inserir Nova Linha" Command="{Binding AddRowCommand}" />
                        <MenuItem Header="📋 Duplicar Linha Selecionada" Command="{Binding DuplicateRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=MainDataGrid}" />
                        <MenuItem Header="🗑️ Marcar Linha(s) para Exclusão" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedItems, ElementName=MainDataGrid}" />
                        <MenuItem Header="↩️ Descartar Alterações da Linha" Click="DiscardRow_Click" />
                        <Separator />
                        <MenuItem Header="📋 Copiar Célula" Click="CopyCell_Click" />
                        <MenuItem Header="📑 Copiar Linha(s) como CSV" Click="CopyRowsCsv_Click" />
                        <MenuItem Header="💾 Copiar Linha(s) como INSERT SQL" Click="CopyRowsSql_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Loading Overlay -->
            <Border Background="#990F172A" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏳ Consultando banco de dados..." FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource FgMainBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12" />
                        <Button Content="Cancelar Consulta" Command="{Binding CancelQueryCommand}" HorizontalAlignment="Center" Style="{StaticResource DangerButton}" Padding="12,4" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Selection Aggregation Stats Bar (DBeaver style) -->
        <Border Grid.Row="3" 
                Background="{DynamicResource BgSurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="8,3"
                Visibility="{Binding SelectionStats.HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                        <TextBlock Text="📊 Seleção" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding SelectionStats.FormattedSummary}" 
                               FontFamily="Consolas, Segoe UI" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource FgMainBrush}" 
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom Table Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutoCommitStatusText}" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" />
                    </Border>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Tabela: " Foreground="{DynamicResource FgMutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" FontSize="11" Margin="0,0,12,0" />
                    <TextBlock Text="Chave Primária: " Foreground="{DynamicResource FgMutedBrush}" FontSize="11" />
                    <TextBlock x:Name="TxtPkColumns" Text="Carregando..." Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

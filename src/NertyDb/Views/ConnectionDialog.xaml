<Window x:Class="NertyDb.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador de Conexões e Logon Senior — NertyDb"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Senior Status -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🔌 Conectar ao Banco de Dados" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" />
                    <TextBlock Text="{Binding SeniorStatusSummary}" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Atualizar Bases" Command="{Binding RefreshSeniorConfigCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" ToolTip="Recarregar senior.cfg" />
                    <Button Content="📂 Localizar senior.cfg..." Command="{Binding BrowseSeniorConfigCommand}" Padding="8,3" FontSize="11" ToolTip="Localizar senior.cfg em outro diretório" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Mode Toggle Selector (Tabs) -->
        <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0"
                             Content="🛡️ Login via Usuário Senior (SGU) — Padrão CBDS"
                             IsChecked="{Binding IsSeniorAuth, Mode=TwoWay}"
                             FontWeight="Bold"
                             FontSize="12"
                             Foreground="{DynamicResource FgMainBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />

                <RadioButton Grid.Column="1"
                             Content="🔑 Login Direto de Banco de Dados (DBA / SA / Windows)"
                             IsChecked="{Binding IsDirectDbAuth, Mode=TwoWay}"
                             FontWeight="Bold"
                             FontSize="12"
                             Foreground="{DynamicResource FgMainBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- MODE 1: SGU LOGIN (Clean CBDS-style single step) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Visibility="{Binding IsSeniorAuth, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="Selecione a Base do Senior e informe suas credenciais SGU:" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,16" FontSize="12" />

                <!-- Senior Base / Alias -->
                <TextBlock Text="Base de Dados Senior (Sistema):" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource FgMainBrush}" />
                <ComboBox ItemsSource="{Binding SeniorAliases}"
                          SelectedItem="{Binding SelectedSeniorAlias, Mode=TwoWay}"
                          DisplayMemberPath="Alias"
                          Padding="8,6"
                          Margin="0,0,0,16" />

                <!-- SGU User -->
                <TextBlock Text="Usuário SGU (Senior):" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource FgMainBrush}" />
                <TextBox Text="{Binding SelectedProfile.SguUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" Margin="0,0,0,16" />

                <!-- SGU Password -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Senha SGU (Senior):" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" VerticalAlignment="Center" />
                    <CheckBox Content="👁️ Mostrar" IsChecked="{Binding ShowSguPassword, Mode=TwoWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <PasswordBox x:Name="TxtSguPassword"
                             PasswordChanged="TxtSguPassword_PasswordChanged"
                             Padding="8,6"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Visibility="{Binding ShowSguPassword, Converter={StaticResource InvBoolToVis}}" />
                <TextBox Text="{Binding CurrentSguPassword, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13"
                         Margin="0,0,0,12"
                         Visibility="{Binding ShowSguPassword, Converter={StaticResource BoolToVis}}" />

                <!-- Save Credentials Checkbox -->
                <CheckBox Content="Salvar credenciais de logon neste computador (Windows DPAPI)"
                          IsChecked="{Binding SelectedProfile.SavePassword, Mode=TwoWay}"
                          Foreground="{DynamicResource FgSecondaryBrush}"
                          FontSize="11"
                          Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- MODE 2: DIRECT DATABASE LOGIN (Full DBA manager) -->
        <Grid Grid.Row="2" Visibility="{Binding IsDirectDbAuth, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Saved Profiles List -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Conexões Salvas" FontWeight="SemiBold" Margin="4,4,4,8" Foreground="{DynamicResource FgSecondaryBrush}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SavedProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="4" Background="{DynamicResource BgInputBrush}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Server}" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profile Actions -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                        <Button Content="+ Novo" Command="{Binding NewProfileCommand}" Margin="0,0,2,0" />
                        <Button Content="📋 Clonar" Command="{Binding CloneProfileCommand}" Margin="2,0,2,0" />
                        <Button Content="🗑️ Excluir" Command="{Binding DeleteProfileCommand}" Margin="2,0,0,0" Style="{StaticResource DangerButton}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Right: Direct DB Form -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Name & SGBD -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome da Conexão:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SGBD / Driver:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableDatabaseTypes}"
                                          SelectedItem="{Binding SelectedDatabaseType, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Server Host & Port -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Servidor / Host (IP ou Instância):" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <Button Content="🔍 Instâncias" Command="{Binding DetectServersCommand}" Padding="4,0" FontSize="10" HorizontalAlignment="Right" ToolTip="Detectar instâncias SQL Server locais" />
                                </DockPanel>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding DetectedServers}"
                                          Text="{Binding SelectedProfile.Server, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Database Name -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Banco de Dados:" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <Button Content="🔍 Listar Bancos" Command="{Binding FetchDatabasesCommand}" Padding="4,0" FontSize="10" HorizontalAlignment="Right" ToolTip="Buscar bancos disponíveis neste servidor" />
                                </DockPanel>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding AvailableDatabases}"
                                          Text="{Binding SelectedProfile.Database, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsOracle, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Service Name / SID (ex: ORCL, XE):" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.ServiceName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- SQL Server Authentication Options -->
                        <StackPanel Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="Autenticação no Banco:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="SQL Server Authentication"
                                             IsChecked="{Binding IsSqlAuth, Mode=TwoWay}"
                                             Foreground="{DynamicResource FgMainBrush}"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Windows Authentication (Integrada)"
                                             IsChecked="{Binding IsWindowsAuth, Mode=TwoWay}"
                                             Foreground="{DynamicResource FgMainBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Direct DB Credentials -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding IsWindowsAuth, Converter={StaticResource InvBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Usuário do Banco (ex: sa):" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Senha do Banco:" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <CheckBox Content="👁️ Mostrar" IsChecked="{Binding ShowPassword, Mode=TwoWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
                                </DockPanel>
                                <PasswordBox x:Name="TxtPassword"
                                             PasswordChanged="TxtPassword_PasswordChanged"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}" />
                                <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Options Checkboxes -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <CheckBox Content="Salvar Senha (DPAPI)"
                                      IsChecked="{Binding SelectedProfile.SavePassword, Mode=TwoWay}"
                                      Foreground="{DynamicResource FgMainBrush}"
                                      Margin="0,0,14,0" />
                            <CheckBox Content="Confiar no Certificado"
                                      IsChecked="{Binding SelectedProfile.TrustServerCertificate, Mode=TwoWay}"
                                      Foreground="{DynamicResource FgMainBrush}"
                                      Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"
                                      Margin="0,0,14,0" />
                            <CheckBox Content="Criptografar Conexão"
                                      IsChecked="{Binding SelectedProfile.Encrypt, Mode=TwoWay}"
                                      Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource FgMainBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status / Result Banner -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="4"
                Visibility="{Binding HasTested, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DiffInsertedBgBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DiffDeletedBgBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TestResultMessage}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" />
        </Border>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button Content="⚡ Testar Conexão" Command="{Binding TestConnectionCommand}" DockPanel.Dock="Left" Padding="14,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Salvar Perfis" Command="{Binding SaveProfilesCommand}" Margin="0,0,8,0" Padding="14,8" Visibility="{Binding IsDirectDbAuth, Converter={StaticResource BoolToVis}}" />
                <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="🚀 Conectar" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="22,8" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

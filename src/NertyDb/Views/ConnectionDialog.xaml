<Window x:Class="NertyDb.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logon Senior (SGU) — NertyDb"
        Width="500" Height="490"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🛡️ Logon Senior (SGU)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" />
                    <TextBlock Text="{Binding SeniorStatusSummary}" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="📂 senior.cfg..." Command="{Binding BrowseSeniorConfigCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Localizar senior.cfg em outro diretório" />
            </DockPanel>
        </Border>

        <!-- SGU LOGIN MODE (Standard CBDS Experience) -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel VerticalAlignment="Center">
                <!-- Base / Alias Selector -->
                <TextBlock Text="Base de Dados Senior (Sistema):" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource FgMainBrush}" />
                <ComboBox ItemsSource="{Binding SeniorAliases}"
                          SelectedItem="{Binding SelectedSeniorAlias, Mode=TwoWay}"
                          DisplayMemberPath="Alias"
                          Padding="8,6"
                          Margin="0,0,0,14" />

                <!-- SGU User -->
                <TextBlock Text="Usuário SGU:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource FgMainBrush}" />
                <TextBox Text="{Binding SelectedProfile.SguUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" Margin="0,0,0,14" />

                <!-- SGU Password -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Senha SGU:" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" VerticalAlignment="Center" />
                    <CheckBox Content="👁️ Mostrar" IsChecked="{Binding ShowSguPassword, Mode=TwoWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <PasswordBox x:Name="TxtSguPassword"
                             PasswordChanged="TxtSguPassword_PasswordChanged"
                             Padding="8,6"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Visibility="{Binding ShowSguPassword, Converter={StaticResource InvBoolToVis}}" />
                <TextBox Text="{Binding CurrentSguPassword, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13"
                         Margin="0,0,0,12"
                         Visibility="{Binding ShowSguPassword, Converter={StaticResource BoolToVis}}" />

                <!-- Save Credentials Checkbox -->
                <CheckBox Content="Salvar credenciais neste computador (Windows DPAPI)"
                          IsChecked="{Binding SelectedProfile.SavePassword, Mode=TwoWay}"
                          Foreground="{DynamicResource FgSecondaryBrush}"
                          FontSize="11"
                          Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Status / Error Banner -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="6"
                Visibility="{Binding HasTested, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DiffInsertedBgBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DiffDeletedBgBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TestResultMessage}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" />
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="⚡ Testar SGU" Command="{Binding TestConnectionCommand}" DockPanel.Dock="Left" Padding="14,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="🚀 Conectar ao Senior" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="22,8" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

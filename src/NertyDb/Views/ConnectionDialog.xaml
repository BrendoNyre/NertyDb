<Window x:Class="NertyDb.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador de Conexões — NertyDb"
        Width="840" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="🔌 Gerenciar Conexões de Banco de Dados" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" />
                <TextBlock Text="SQL Server &amp; Oracle (Senior Sistemas)" HorizontalAlignment="Right" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main Body (Split Left List & Right Form) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Saved Profiles List -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Conexões Salvas" FontWeight="SemiBold" Margin="4,4,4,8" Foreground="{DynamicResource FgSecondaryBrush}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SavedProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" Margin="0,2" CornerRadius="4" Background="{DynamicResource BgInputBrush}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Server}" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profile Actions -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                        <Button Content="+ Novo" Command="{Binding NewProfileCommand}" Margin="0,0,2,0" />
                        <Button Content="📋 Clonar" Command="{Binding CloneProfileCommand}" Margin="2,0,2,0" />
                        <Button Content="🗑️ Excluir" Command="{Binding DeleteProfileCommand}" Margin="2,0,0,0" Style="{StaticResource DangerButton}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Right: Profile Configuration Details -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Database Engine Selector -->
                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SGBD / Driver:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource FgMainBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableDatabaseTypes}"
                                          SelectedItem="{Binding SelectedDatabaseType, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Name & Port -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome da Conexão:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Server Host with Suggestions and Detect Button -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Servidor / Host (IP ou Instância):" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <Button Content="🔍 Instâncias" Command="{Binding DetectServersCommand}" Padding="4,0" FontSize="10" HorizontalAlignment="Right" ToolTip="Detectar instâncias SQL Server locais" />
                                </DockPanel>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding DetectedServers}"
                                          Text="{Binding SelectedProfile.Server, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            
                            <!-- SQL Server Database field with List button -->
                            <StackPanel Grid.Column="2" Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Banco de Dados:" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <Button Content="🔍 Listar" Command="{Binding FetchDatabasesCommand}" Padding="4,0" FontSize="10" HorizontalAlignment="Right" ToolTip="Buscar bancos disponíveis neste servidor" />
                                </DockPanel>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding AvailableDatabases}"
                                          Text="{Binding SelectedProfile.Database, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Oracle Service Name / SID field -->
                            <StackPanel Grid.Column="2" Visibility="{Binding IsOracle, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Service Name / SID (ex: ORCL, XE):" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.ServiceName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- SQL Server Authentication Options -->
                        <StackPanel Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="Autenticação:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton Content="SQL Server Authentication"
                                             IsChecked="{Binding IsSqlAuth, Mode=TwoWay}"
                                             Foreground="{DynamicResource FgMainBrush}"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Windows Authentication (Integrada)"
                                             IsChecked="{Binding IsWindowsAuth, Mode=TwoWay}"
                                             Foreground="{DynamicResource FgMainBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Credentials -->
                        <Grid Margin="0,0,0,10" Visibility="{Binding IsWindowsAuth, Converter={StaticResource InvBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Usuário:" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Senha:" Foreground="{DynamicResource FgSecondaryBrush}" />
                                    <CheckBox Content="👁️ Mostrar" IsChecked="{Binding ShowPassword, Mode=TwoWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
                                </DockPanel>
                                
                                <PasswordBox x:Name="TxtPassword"
                                             PasswordChanged="TxtPassword_PasswordChanged"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}" />
                                <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Options Checkboxes -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox Content="Salvar Senha (DPAPI)"
                                      IsChecked="{Binding SelectedProfile.SavePassword, Mode=TwoWay}"
                                      Foreground="{DynamicResource FgMainBrush}"
                                      Margin="0,0,16,0" />
                            <CheckBox Content="Confiar no Certificado"
                                      IsChecked="{Binding SelectedProfile.TrustServerCertificate, Mode=TwoWay}"
                                      Foreground="{DynamicResource FgMainBrush}"
                                      Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"
                                      Margin="0,0,16,0" />
                            <CheckBox Content="Criptografar Conexão"
                                      IsChecked="{Binding SelectedProfile.Encrypt, Mode=TwoWay}"
                                      Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource FgMainBrush}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Timeout de Conexão (seg):" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.ConnectionTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Timeout de Comando (seg):" Margin="0,0,0,4" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedProfile.CommandTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Test Result Banner -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="4"
                Visibility="{Binding HasTested, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DiffInsertedBgBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DiffDeletedBgBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TestResultMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMainBrush}" />
        </Border>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="⚡ Testar Conexão" Command="{Binding TestConnectionCommand}" DockPanel.Dock="Left" Padding="16,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Salvar Perfis" Command="{Binding SaveProfilesCommand}" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="🚀 Conectar" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

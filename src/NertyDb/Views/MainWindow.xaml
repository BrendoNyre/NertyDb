<Window x:Class="NertyDb.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NertyDb.ViewModels"
        xmlns:views="clr-namespace:NertyDb.Views"
        Title="NertyDb — Cliente de Banco de Dados Senior (Portable)"
        Height="780" Width="1260"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewQueryTabCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenConnectionsDialogCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Actions Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <!-- App Logo & Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Text="⚡ NertyDb" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SENIOR" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="🔌 Conexões..." Command="{Binding OpenConnectionsDialogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,5" ToolTip="Gerenciar conexões salvas (Ctrl+O)" />
                    <Button Content="+ Nova Consulta" Command="{Binding NewQueryTabCommand}" Margin="0,0,6,0" Padding="10,5" ToolTip="Abrir editor SQL livre (Ctrl+N)" />
                    <Button Content="🔄 Atualizar" Command="{Binding RefreshAllCommand}" Margin="0,0,6,0" Padding="8,5" ToolTip="Atualizar objetos do banco (F5)" />
                    
                    <!-- Transaction Management Controls (DBeaver Style) -->
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="4,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding AutoCommitLabel}" Command="{Binding ToggleAutoCommitCommand}" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="11" ToolTip="Alternar modo Auto-Commit (Ligado / Manual)" />
                            <Button Content="💾 Commit" Command="{Binding CommitActiveTabCommand}" Style="{StaticResource SuccessButton}" Padding="8,3" Margin="2,0" ToolTip="Gravar transação e alterações pendentes" />
                            <Button Content="↩️ Rollback" Command="{Binding RollbackActiveTabCommand}" Padding="8,3" ToolTip="Descartar transação e alterações pendentes" />
                        </StackPanel>
                    </Border>

                    <Button Content="🌓 Tema" Command="{Binding ToggleThemeCommand}" Margin="0,0,6,0" Padding="8,5" ToolTip="Alternar tema Claro / Escuro" />
                    <Button Content="❔ Ajuda / Atalhos" Command="{Binding OpenAboutCommand}" Margin="0,0,6,0" Padding="8,5" ToolTip="Sobre o NertyDb e atalhos" />
                </StackPanel>

                <!-- Right Info Bar: Active Connection Indicator -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveConnection}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource FgMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActiveConnectionSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgMainBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Splitter (Left Sidebar & Center Document Tabs) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Schema Explorer & Fuzzy Search -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid DataContext="{Binding SchemaTree}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Fuzzy Search Box -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     Padding="6,4"
                                     Background="{DynamicResource BgInputBrush}"
                                     ToolTip="Busca rápida por nome da tabela ou coluna (ex: r034, ponto, batida)" />
                            <TextBlock Text="🔍" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource FgMutedBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <!-- TreeView with double-click navigation & Virtualization -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FilteredNodes}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              MouseDoubleClick="TreeView_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:SchemaNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{DynamicResource FgMainBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SubTitle}" Margin="6,0,0,0" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📊 Consultar Dados (Top 100)" Command="{Binding OpenTableCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="🔢 Contar Linhas (COUNT)" Command="{Binding CountRowsCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="📝 Gerar SELECT" Command="{Binding GenerateSelectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="➕ Gerar INSERT" Command="{Binding GenerateInsertCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="🏗️ Gerar CREATE TABLE" Command="{Binding GenerateCreateTableCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="📋 Copiar Nome da Tabela" Command="{Binding CopyNameCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="🔄 Atualizar" Command="{Binding RefreshCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- Schema Loading Overlay -->
                    <Border Grid.Row="1" Background="#AA0B1120" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Carregando objetos..." FontSize="12" Foreground="{DynamicResource FgMainBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <ProgressBar IsIndeterminate="True" Width="140" Height="4" />
                        </StackPanel>
                    </Border>

                    <!-- Schema Tree Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource FgMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter Grip -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE" />

            <!-- Center: Tabbed Documents (Grids & SQL Editors) -->
            <Grid Grid.Column="2" Background="{DynamicResource BgMainBrush}">
                <!-- TabControl with Open Documents -->
                <TabControl ItemsSource="{Binding DocumentTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            Visibility="{Binding HasDocumentTabs, Converter={StaticResource BoolToVis}}">
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:TableDataViewModel}">
                            <views:TableDataView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SqlEditorViewModel}">
                            <views:SqlEditorView />
                        </DataTemplate>
                    </TabControl.Resources>

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="✕"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource FgMutedBrush}"
                                        Padding="3,0"
                                        FontSize="10"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentDangerBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <!-- Empty State (when no tabs are open) -->
                <Border Background="{DynamicResource BgMainBrush}" Visibility="{Binding HasDocumentTabs, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="⚡ NertyDb" FontWeight="Bold" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Cliente de Banco de Dados Senior — Ferramenta Auxiliar de Consulta" FontSize="13" Foreground="{DynamicResource FgSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Ações Rápidas:" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource FgMainBrush}" />
                                <Button Content="🔌 Conectar a um Banco de Dados" Command="{Binding OpenConnectionsDialogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Padding="14,8" HorizontalAlignment="Stretch" />
                                <Button Content="+ Nova Consulta SQL Livre" Command="{Binding NewQueryTabCommand}" Margin="0,0,0,8" Padding="14,8" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Dica: Dê duplo clique em qualquer tabela na árvore à esquerda para abrir a grade de dados com edição inline." FontSize="11" Foreground="{DynamicResource FgMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Application Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ServerVersion}" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" Margin="0,0,16,0" />
                    <TextBlock Text="NertyDb v1.1 Portable" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

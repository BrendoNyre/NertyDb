<Window x:Class="NertyDb.Views.PendingChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar e Salvar Alterações — NertyDb"
        Width="820" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource FgMainBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Revisão de Alterações Pendentes" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FgMainBrush}" />
                    <Border Background="{DynamicResource DiffModifiedBgBrush}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DiffModifiedFgBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Half: List of Changes -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Lista de Operações Detectadas:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" Margin="4,2,4,6" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Changes}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,6" Margin="0,2" CornerRadius="4" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Background="{Binding Type, Converter={StaticResource ChangeTypeToBrush}}"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type, Converter={StaticResource ChangeTypeToText}}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource FgMainBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" Cursor="SizeNS" />

        <!-- Bottom Half: Generated SQL Preview -->
        <Border Grid.Row="3" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,2,4,6">
                    <TextBlock Text="Script SQL Gerado (Transação Atômica):" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                    <Button Content="📋 Copiar Script" Command="{Binding CopyScriptCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,2" FontSize="11" />
                </DockPanel>
                <TextBox Grid.Row="1"
                         Text="{Binding GeneratedSqlScript, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="{StaticResource CodeFont}"
                         FontSize="12"
                         Background="{DynamicResource BgInputBrush}"
                         Foreground="{DynamicResource FgMainBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!-- Status / Error Banner -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="10,6"
                CornerRadius="4"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource DiffDeletedBgBrush}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DiffDeletedFgBrush}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Voltar para a Grade" Click="Close_Click" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="💾 Confirmar e Gravar no Banco" Command="{Binding CommitCommand}" Style="{StaticResource SuccessButton}" Padding="20,8" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

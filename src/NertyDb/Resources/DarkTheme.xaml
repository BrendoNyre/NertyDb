<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Palette Colors (Optimized for High Contrast & Readability) -->
    <Color x:Key="BgMainColor">#0F172A</Color>       <!-- Slate 900 Window Background -->
    <Color x:Key="BgSurfaceColor">#1E293B</Color>    <!-- Slate 800 Elevated Card / Container -->
    <Color x:Key="BgHeaderColor">#0F172A</Color>     <!-- Slate 900 Header / Titlebars -->
    <Color x:Key="BgSidebarColor">#0B1120</Color>    <!-- Darker Slate Navy Sidebar -->
    <Color x:Key="BgInputColor">#0B132B</Color>      <!-- Very Dark Navy/Black Input Background for High Contrast -->
    <Color x:Key="BgCardColor">#1E293B</Color>
    <Color x:Key="BgTabSelectedColor">#334155</Color>

    <!-- High-Contrast Text Colors for Dark Theme -->
    <Color x:Key="FgMainColor">#FFFFFF</Color>       <!-- Pure Crisp White for Typed Input and Headings -->
    <Color x:Key="FgSecondaryColor">#E2E8F0</Color>  <!-- Slate 200 - Very Clear Secondary Text / Labels -->
    <Color x:Key="FgMutedColor">#94A3B8</Color>      <!-- Slate 400 - Distinct and Legible Placeholder / Hints -->
    <Color x:Key="BorderColor">#475569</Color>       <!-- Slate 600 - High-visibility input and section borders -->
    <Color x:Key="BorderFocusColor">#60A5FA</Color>  <!-- Blue 400 - Clear active focus highlight -->

    <Color x:Key="AccentColor">#3B82F6</Color>       <!-- Blue 500 -->
    <Color x:Key="AccentHoverColor">#60A5FA</Color>  <!-- Blue 400 -->
    <Color x:Key="AccentSuccessColor">#10B981</Color><!-- Emerald 500 -->
    <Color x:Key="AccentWarningColor">#F59E0B</Color><!-- Amber 500 -->
    <Color x:Key="AccentDangerColor">#EF4444</Color> <!-- Red 500 -->

    <!-- Diff Colors for DataGrid -->
    <Color x:Key="DiffModifiedBgColor">#451A03</Color> <!-- Amber Dark -->
    <Color x:Key="DiffModifiedFgColor">#FDE68A</Color>
    <Color x:Key="DiffInsertedBgColor">#064E3B</Color> <!-- Green Dark -->
    <Color x:Key="DiffInsertedFgColor">#A7F3D0</Color>
    <Color x:Key="DiffDeletedBgColor">#7F1D1D</Color>  <!-- Red Dark -->
    <Color x:Key="DiffDeletedFgColor">#FECACA</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgHeaderBrush" Color="{StaticResource BgHeaderColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgTabSelectedBrush" Color="{StaticResource BgTabSelectedColor}" />

    <SolidColorBrush x:Key="FgMainBrush" Color="{StaticResource FgMainColor}" />
    <SolidColorBrush x:Key="FgSecondaryBrush" Color="{StaticResource FgSecondaryColor}" />
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />

    <SolidColorBrush x:Key="DiffModifiedBgBrush" Color="{StaticResource DiffModifiedBgColor}" />
    <SolidColorBrush x:Key="DiffModifiedFgBrush" Color="{StaticResource DiffModifiedFgColor}" />
    <SolidColorBrush x:Key="DiffInsertedBgBrush" Color="{StaticResource DiffInsertedBgColor}" />
    <SolidColorBrush x:Key="DiffInsertedFgBrush" Color="{StaticResource DiffInsertedFgColor}" />
    <SolidColorBrush x:Key="DiffDeletedBgBrush" Color="{StaticResource DiffDeletedBgColor}" />
    <SolidColorBrush x:Key="DiffDeletedFgBrush" Color="{StaticResource DiffDeletedFgColor}" />

</ResourceDictionary>

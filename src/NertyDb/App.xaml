<Application x:Class="NertyDb.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NertyDb.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/LightTheme.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <views:BoolToVisibilityConverter x:Key="BoolToVis" />
            <views:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <views:NullToVisibilityConverter x:Key="NullToVis" />
            <views:ChangeTypeToBrushConverter x:Key="ChangeTypeToBrush" />
            <views:ChangeTypeToTextConverter x:Key="ChangeTypeToText" />
            <views:NullableValueDisplayConverter x:Key="NullableValConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
